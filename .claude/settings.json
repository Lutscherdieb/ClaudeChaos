{
  "permissions": {
    "allow": [
      "PowerShell(Get-Process *)",
      "Bash(tasklist*)",
      "PowerShell(Get-Content \"$env:APPDATA\\CubeChaos\\*)",
      "PowerShell(Start-Sleep -Seconds *)",
      "PowerShell(Get-Item \"$env:APPDATA\\CubeChaos\\*)",
      "PowerShell(Select-String -Path *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "bash .claude/hooks/check-md-dsl-safety.sh",
            "timeout": 15,
            "statusMessage": "Checking .md file for DSL-unsafe bare keywords..."
          },
          {
            "type": "command",
            "shell": "bash",
            "command": "bash .claude/hooks/regen-preview-cards.sh",
            "timeout": 30,
            "statusMessage": "Regenerating mod preview cards..."
          },
          {
            "type": "command",
            "shell": "bash",
            "command": "bash .claude/hooks/regen-terrain-screenshots.sh",
            "timeout": 30,
            "statusMessage": "Regenerating terrain battlefield screenshots..."
          },
          {
            "type": "command",
            "shell": "bash",
            "command": "bash .claude/hooks/regen-readme-previews.sh",
            "timeout": 30,
            "statusMessage": "Syncing README preview sections..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "bash .claude/hooks/check-launch-log.sh",
            "timeout": 15,
            "statusMessage": "Checking launch/Log.txt freshness..."
          },
          {
            "type": "command",
            "shell": "bash",
            "command": "bash .claude/hooks/check-sprite-coverage.sh",
            "timeout": 15,
            "statusMessage": "Checking sprite coverage for new PERK:/CUBE: blocks..."
          },
          {
            "type": "command",
            "shell": "bash",
            "command": "bash .claude/hooks/check-visual-coverage.sh",
            "timeout": 15,
            "statusMessage": "Checking Visual: placement-preview coverage for positional cubes..."
          },
          {
            "type": "command",
            "shell": "bash",
            "command": "bash .claude/hooks/check-workflow-overview.sh",
            "timeout": 15,
            "statusMessage": "Checking WORKFLOW_OVERVIEW.md freshness against the orchestrator..."
          },
          {
            "type": "command",
            "shell": "bash",
            "command": "bash .claude/hooks/check-skill-cold-test.sh",
            "timeout": 15,
            "statusMessage": "Checking whether a new/changed skill needs a cube-chaos-doc-audit cold test..."
          }
        ]
      }
    ]
  }
}
